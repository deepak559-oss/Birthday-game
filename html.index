<!DOCTYPE html>
<html>
<head>
  <title>Happy Birthday! 🎉💕</title>

  <!-- Cute Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&family=Poppins:wght@600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Nunito', 'Poppins', sans-serif;
      text-align: center;
      background: linear-gradient(135deg, #ffccf2, #ffd9ec, #ffe6f7);
      color: #ff4da6;
      padding-top: 40px;
      overflow-x: hidden;
    }

    h1 {
      font-size: 45px;
      margin-bottom: 5px;
      font-family: 'Poppins', sans-serif;
    }

    p {
      font-size: 22px;
    }

    .emoji-btn {
      font-size: 45px;
      padding: 15px;
      margin: 10px;
      background: #ffffff90;
      border: none;
      border-radius: 20px;
      cursor: pointer;
      transition: 0.3s;
      font-family: 'Nunito', sans-serif;
    }

    .emoji-btn:hover {
      transform: scale(1.2);
      background: #fff0f7;
    }

    #message1, #message2, #finalMessage {
      margin-top: 30px;
      font-size: 30px;
      display: none;
      color: #ff1a75;
      padding: 20px;
      font-family: 'Poppins', sans-serif;
    }

    /* Falling sparkles */
    .sparkle {
      position: fixed;
      top: -20px;
      font-size: 20px;
      animation: fall linear forwards;
      opacity: 0.8;
      z-index: -1;
    }

    @keyframes fall {
      to {
        transform: translateY(120vh);
        opacity: 0;
      }
    }

    /* Rising hearts */
    .heart {
      position: fixed;
      bottom: -20px;
      font-size: 30px;
      color: #ff66a3;
      animation: rise 3s ease-out forwards;
      opacity: 0.9;
    }

    @keyframes rise {
      0% {transform: translateY(0) scale(0.7); opacity: 0.8;}
      100% {transform: translateY(-120vh) scale(1.3); opacity: 0;}
    }
  </style>
</head>

<body>

  <h1>🎉💗 Happy Birthday!! 💗🎉</h1>

  <!-- LEVEL 1 -->
  <p>Level 1: Pick the right emoji to begin! 🌈✨</p>

  <div id="game1">
    <button class="emoji-btn" onclick="level1('wrong')">🍕</button>
    <button class="emoji-btn" onclick="level1('wrong')">🐶</button>
    <button class="emoji-btn" onclick="level1('right')">🎁</button>
    <button class="emoji-btn" onclick="level1('wrong')">🌸</button>
    <button class="emoji-btn" onclick="level1('wrong')">🍓</button>
  </div>

  <div id="message1">✨ Yay! Level 2: Find the hidden heart! 💞</div>

  <!-- LEVEL 2 -->
  <div id="game2" style="display:none;">
    <button class="emoji-btn" onclick="level2('wrong')">⭐</button>
    <button class="emoji-btn" onclick="level2('right')">💖</button>
    <button class="emoji-btn" onclick="level2('wrong')">🌼</button>
    <button class="emoji-btn" onclick="level2('wrong')">🐱</button>
  </div>

  <div id="message2">🌸 Cute! Level 3: Choose the birthday cupcake! 🧁✨</div>

  <!-- LEVEL 3 -->
  <div id="game3" style="display:none;">
    <button class="emoji-btn" onclick="level3('wrong')">🍪</button>
    <button class="emoji-btn" onclick="level3('right')">🧁</button>
    <button class="emoji-btn" onclick="level3('wrong')">🍩</button>
    <button class="emoji-btn" onclick="level3('wrong')">🍬</button>
  </div>

  <!-- FINAL CUTE MESSAGE -->
  <div id="finalMessage">
    <div style="font-size: 38px; line-height: 1.4;">
      🎀💗 Happiest birthday babiee 💗🎀 <br>
      I love you sooo much 💞✨
    </div>
  </div>

  <script>
    // LEVEL 1
    function level1(choice) {
      if (choice === "right") {
        document.getElementById("game1").style.display = "none";
        document.getElementById("message1").style.display = "block";
        document.getElementById("game2").style.display = "block";
      } else {
        alert("Try again! 💖");
      }
    }

    // LEVEL 2
    function level2(choice) {
      if (choice === "right") {
        document.getElementById("game2").style.display = "none";
        document.getElementById("message2").style.display = "block";
        document.getElementById("game3").style.display = "block";
      } else {
        alert("Almost! Try again 🌸");
      }
    }

    // LEVEL 3
    function level3(choice) {
      if (choice === "right") {
        document.getElementById("game3").style.display = "none";
        document.getElementById("finalMessage").style.display = "block";
        startHearts();
      } else {
        alert("Not this one! Try again ✨");
      }
    }

    // Falling sparkles loop
    function createSparkle() {
      const sparkle = document.createElement("div");
      sparkle.classList.add("sparkle");
      sparkle.innerHTML = "✨";
      sparkle.style.left = Math.random() * window.innerWidth + "px";
      sparkle.style.animationDuration = (2 + Math.random() * 3) + "s";
      document.body.appendChild(sparkle);
      setTimeout(() => sparkle.remove(), 5000);
    }
    setInterval(createSparkle, 300);

    // Hearts after final level
    function startHearts() {
      setInterval(() => {
        const heart = document.createElement("div");
        heart.classList.add("heart");
        heart.innerHTML = "💗";
        heart.style.left = Math.random() * window.innerWidth + "px";
        document.body.appendChild(heart);
        setTimeout(() => heart.remove(), 3000);
      }, 400);
    }
  </script>

</body>
</html>
